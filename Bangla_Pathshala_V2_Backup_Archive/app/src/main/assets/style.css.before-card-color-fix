/* Web/Desktop: different color for each class button */
@media(min-width:721px){

  .nav-classes .nav-class:nth-child(1){background:#e8f4ff !important;}
  .nav-classes .nav-class:nth-child(2){background:#eaf8ed !important;}
  .nav-classes .nav-class:nth-child(3){background:#fff3e6 !important;}
  .nav-classes .nav-class:nth-child(4){background:#f3ebff !important;}
  .nav-classes .nav-class:nth-child(5){background:#fff0f3 !important;}
  .nav-classes .nav-class:nth-child(6){background:#e8f8f7 !important;}
  .nav-classes .nav-class:nth-child(7){background:#fff8df !important;}
  .nav-classes .nav-class:nth-child(8){background:#eaf0ff !important;}
  .nav-classes .nav-class:nth-child(9){background:#f1f7e8 !important;}
  .nav-classes .nav-class:nth-child(10){background:#ffedf5 !important;}

}

/* Poem cards: 3 cards per row on Web and Phone */
.poem-grid{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
}

@media(max-width:720px){
  .poem-grid{
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    gap:10px !important;
  }
}

@media(max-width:430px){
  .poem-grid{
    grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    gap:6px !important;
  }
}
