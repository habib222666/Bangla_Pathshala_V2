*{box-sizing:border-box}
:root{
  --blue:#24569a;
  --blue-dark:#173d72;
  --green:#16834b;
  --text:#14243a;
  --muted:#64758b;
  --line:#e2e8f0;
  --panel:#ffffff;
  --page:#fbfcff;
  --sidebar:#ffffff;
}
html,body{margin:0;min-height:100%;background:var(--page);color:var(--text);font-family:"Noto Sans Bengali","Noto Sans",system-ui,sans-serif}
body{overflow-x:hidden}
button,input,textarea{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}

.topbar{height:96px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px 0 34px;position:sticky;top:0;z-index:20}
.brand-wrap{display:flex;align-items:center;gap:14px}
.brand-logo{width:68px;height:68px;position:relative;display:flex;align-items:center;justify-content:center}
.brand-logo .book{font-size:49px;filter:saturate(.9)}
.brand-logo .leaf{position:absolute;top:3px;right:7px;font-size:25px}
.brand-name{font-size:32px;line-height:1.05;font-weight:900;color:#15519a;letter-spacing:-.8px}
.brand-tagline{font-size:16px;color:#5f7da4;margin-top:5px}
.top-actions{display:flex;gap:30px;align-items:center}
.top-action{border:0;background:transparent;color:#2d5e98;display:flex;flex-direction:column;align-items:center;gap:0;padding:5px 4px;box-shadow:none}
.top-action span{font-family:Arial,sans-serif;font-size:34px;line-height:32px;font-weight:300}
.top-action small{font-size:15px;margin-top:4px}

.app-shell{display:flex;min-height:calc(100vh - 96px)}
.sidebar{width:284px;flex:0 0 284px;background:var(--sidebar);border-right:1px solid var(--line);position:sticky;top:96px;height:calc(100vh - 96px);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.side-nav{padding:23px 16px 8px}
.nav-item{width:100%;border:0;background:transparent;color:#274b74;text-align:left;display:flex;align-items:center;gap:18px;border-radius:15px;padding:13px 13px;margin:3px 0;font-size:21px;box-shadow:none}
.nav-item:hover{background:#f3f7ff}
.nav-item.active{background:linear-gradient(90deg,#e6e5ff,#e8e9ff);color:#173fc1;font-weight:800}
.nav-icon{width:30px;text-align:center;font-family:Arial,sans-serif;font-size:28px;line-height:1;color:#35659a}
.nav-item.active .nav-icon{color:#1e46bf}
.nav-classes{margin:2px 0 10px}
.nav-class{width:100%;border:0;background:transparent;color:#315b8d;text-align:left;display:flex;align-items:center;gap:18px;border-radius:14px;padding:10px 13px;font-size:20px;box-shadow:none}
.nav-class:hover{background:#f5f8fd}
.nav-class.active{color:#183fbd;background:#ecebff;font-weight:800}
.nav-class .nav-icon{font-size:23px}
.sidebar-art{text-align:center;color:#2460a0;font-size:18px;padding:20px 10px 25px;background:radial-gradient(circle at 20% 20%,#edf6ff,transparent 48%),linear-gradient(180deg,transparent,#f1f8ff)}
.books{font-size:82px;line-height:1;margin-bottom:12px}

.content{flex:1;min-width:0;padding:14px 28px 44px;background:linear-gradient(180deg,#fbfcff,#fff)}
.dashboard{max-width:1250px;margin:0 auto}
.class-banner{height:100px;border-radius:24px;background:linear-gradient(105deg,#edf2ff,#f4f6ff 58%,#e7f4ff);display:flex;align-items:center;padding:15px 28px;position:relative;overflow:hidden;margin-bottom:24px}
.class-banner:after{content:"";position:absolute;right:-35px;bottom:-75px;width:310px;height:130px;border-radius:50%;background:#5fd0aa55;box-shadow:-90px 10px 0 #76d9bd55,-170px 17px 0 #8ce7d355}
.banner-icon{font-size:50px;width:82px;text-align:center;margin-right:14px;z-index:1}
.class-banner h1{margin:0;color:#1747a6;font-size:34px;line-height:1.1;position:relative;z-index:2}
.class-banner p{margin:7px 0 0;color:#5f78a1;font-size:20px;position:relative;z-index:2}
.banner-art{margin-left:auto;font-size:29px;letter-spacing:5px;z-index:2;opacity:.8}
.section-tools{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.welcome{font-size:21px;font-weight:800;color:#294d79;margin-right:auto}
.soft-btn{border:0;border-radius:24px;padding:10px 17px;background:#f0f5ff;color:#245da1;box-shadow:none;font-weight:700}
.soft-btn:hover{background:#e6efff}
.search-box{width:280px;height:44px;border:1px solid #dce5ef;border-radius:22px;padding:0 17px;background:#fff;outline:none;color:var(--text)}
.search-box:focus{border-color:#8fb2df;box-shadow:0 0 0 3px #eaf2ff}

.poem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.card{position:relative;min-height:300px;border:0;border-radius:18px;padding:14px 18px 14px;overflow:hidden;box-shadow:0 8px 24px rgba(39,65,100,.08);transition:transform .16s ease,box-shadow .16s ease;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start}
.card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(39,65,100,.13)}
.card:after{content:"";position:absolute;right:-25px;bottom:-30px;width:130px;height:130px;border-radius:55% 45% 55% 45%;background:rgba(255,255,255,.34);transform:rotate(-20deg)}
.card:nth-child(1){background:#ffe8ef!important}.card:nth-child(2){background:#e3f7d9!important}.card:nth-child(3){background:#dff3ff!important}.card:nth-child(4){background:#eee1ff!important}.card:nth-child(5){background:#fff1bd!important}.card:nth-child(6){background:#d9f7f1!important}
.card-illustration{width:100%;height:96px;display:flex;align-items:center;justify-content:flex-start;font-size:76px;line-height:1;position:relative;z-index:1}
.card-illustration img{max-height:95px;max-width:155px;object-fit:contain}
.favoriteBtn{position:absolute;right:17px;top:17px;width:38px;height:38px;padding:0;border:0;background:transparent;box-shadow:none;font-size:31px;line-height:1;color:#d72a72;z-index:3}
.card:nth-child(2) .favoriteBtn{color:#168b39}.card:nth-child(3) .favoriteBtn{color:#006bb9}.card:nth-child(4) .favoriteBtn{color:#6c1ec6}.card:nth-child(5) .favoriteBtn{color:#ef6e00}.card:nth-child(6) .favoriteBtn{color:#118d8c}
.card h3{margin:2px 0 3px;font-size:31px;line-height:1.15;font-weight:900;color:#7a159b;position:relative;z-index:1}
.card:nth-child(2) h3{color:#0574d0}.card:nth-child(3) h3{color:#dc214f}.card:nth-child(4) h3{color:#6c18be}.card:nth-child(5) h3{color:#e86b00}.card:nth-child(6) h3{color:#cf0a8b}
.card .poet{font-size:17px;color:#168448;font-weight:800;position:relative;z-index:1}
.card .excerpt{font-size:18px;line-height:1.55;margin:17px 0 14px;color:#162235;white-space:pre-line;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;position:relative;z-index:1}
.read-btn{margin-top:auto;border:0;border-radius:25px;background:rgba(255,255,255,.48);padding:10px 23px;color:#a3008f;font-size:18px;font-weight:900;position:relative;z-index:2;box-shadow:none}
.card:nth-child(2) .read-btn{color:#09873c}.card:nth-child(3) .read-btn{color:#0b6db8}.card:nth-child(4) .read-btn{color:#6516c7}.card:nth-child(5) .read-btn{color:#f06b00}.card:nth-child(6) .read-btn{color:#008d8c}
.deleteUserPoem{position:absolute!important;right:12px;bottom:12px;z-index:5;background:#ffffffaa!important;color:#8a3940!important;padding:5px 8px!important;border-radius:10px!important;font-size:11px!important}

.reader-view{max-width:900px;margin:0 auto}
.reader-actions{display:flex;justify-content:space-between;gap:10px;margin-bottom:12px}
.paper{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px 32px;box-shadow:0 8px 24px rgba(39,65,100,.07)}
.paper h1{text-align:center;color:#1747a6;font-size:34px;margin:8px 0}.paper #poet{text-align:center;margin:0 0 24px}.paper pre{white-space:pre-wrap;font-family:"Noto Sans Bengali",sans-serif;font-size:19px;line-height:1.9;margin:0;color:#172338}
.recite-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.recite-controls button{border:0;border-radius:16px;padding:9px 12px;background:#eef5ff;color:#245da1}
#editText{width:100%;min-height:300px;border:1px solid #dce5ef;border-radius:16px;padding:14px;line-height:1.8;resize:vertical}.editActions{display:flex;gap:10px;margin-top:10px}.editActions button{flex:1;border:0;border-radius:14px;padding:11px}.editActions #saveBtn{background:#e2f7e7;color:#28713d}.editActions #cancelBtn{background:#f4f4f4;color:#555}
.empty{grid-column:1/-1;background:#fff;border:1px dashed #d9e2ed;border-radius:20px;padding:35px;text-align:center;color:#718096}
.muted{color:#687991;font-size:15px}

body.dark{--text:#eef4ff;--muted:#aab8ce;--line:#2b3b52;--panel:#162234;--page:#0f1724;--sidebar:#111b2a;background:#0f1724;color:#eef4ff}.dark .topbar,.dark .paper,.dark .card{color:#eef4ff}.dark .topbar,.dark .sidebar,.dark .paper{background:#111b2a}.dark .content{background:#0f1724}.dark .nav-item,.dark .nav-class{color:#c7d7ef}.dark .class-banner{background:linear-gradient(105deg,#1b2940,#18263b)}.dark .search-box{background:#172438;color:#fff;border-color:#31445e}.dark .soft-btn{background:#1d304a;color:#cfe1ff}.dark .card .excerpt{color:#172338}

@media(max-width:1000px){.sidebar{width:225px;flex-basis:225px}.poem-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-name{font-size:27px}.top-actions{gap:15px}}
@media(max-width:720px){
  .topbar{height:78px;padding:0 13px}.brand-logo{width:46px;height:46px}.brand-logo .book{font-size:36px}.brand-logo .leaf{font-size:18px;top:0}.brand-name{font-size:23px}.brand-tagline{font-size:11px}.top-actions{gap:4px}.top-action span{font-size:27px;line-height:25px}.top-action small{font-size:10px}
  .app-shell{display:block;min-height:calc(100vh - 78px)}.sidebar{position:static;width:100%;height:auto;border-right:0;border-bottom:1px solid var(--line);display:block}.side-nav{display:flex;gap:4px;overflow-x:auto;padding:7px 8px}.nav-item{width:auto;white-space:nowrap;padding:8px 11px;font-size:14px;gap:5px}.nav-item .nav-icon{font-size:20px;width:auto}.nav-classes{display:flex;gap:4px;margin:0}.nav-class{width:auto;white-space:nowrap;padding:8px 10px;font-size:13px;gap:5px}.nav-class .nav-icon{font-size:16px}.sidebar-art{display:none}
  .content{padding:10px 10px 28px}.class-banner{height:84px;border-radius:18px;padding:10px 14px;margin-bottom:14px}.banner-icon{font-size:35px;width:50px;margin-right:4px}.class-banner h1{font-size:24px}.class-banner p{font-size:14px;margin-top:3px}.banner-art{font-size:20px;letter-spacing:0}
  .section-tools{flex-wrap:wrap}.welcome{font-size:17px}.search-box{order:3;width:100%}
  .poem-grid{grid-template-columns:1fr 1fr;gap:10px}.card{min-height:315px;padding:12px 13px;border-radius:18px}.card-illustration{height:72px;font-size:54px}.card-illustration img{max-height:70px;max-width:110px}.card h3{font-size:23px}.card .poet{font-size:13px}.card .excerpt{font-size:14px;line-height:1.5;margin:10px 0}.read-btn{font-size:14px;padding:8px 14px}.favoriteBtn{right:7px;top:7px;font-size:26px}
  .paper{padding:20px 16px;border-radius:18px}.paper h1{font-size:26px}.paper pre{font-size:17px}.reader-actions{flex-direction:column}.recite-controls button{font-size:13px}
}
@media(max-width:430px){.poem-grid{grid-template-columns:1fr}.card{min-height:300px}.top-action:nth-child(3){display:none}.brand-name{font-size:20px}}


/* Final UI fixes: smaller read button + global search class label */
.read-btn{padding:6px 12px!important;font-size:13px!important;border-radius:16px!important;min-height:30px!important}
.global-class-label{font-size:12px;color:#5d6f86;margin:2px 0 6px;font-weight:700}


/* Fix poem read button tap/click on phone */
.card:after{pointer-events:none !important;}
.read-btn{position:relative !important;z-index:20 !important;pointer-events:auto !important;cursor:pointer !important;touch-action:manipulation !important;}


/* FINAL: compact poem read buttons */
.card .readBtn,
.card button.readBtn,
.globalSearchCard .readBtn,
.globalSearchCard button.readBtn {
  display: inline-flex !important;
  width: fit-content !important;
  min-width: 0 !important;
  max-width: max-content !important;
  min-height: 0 !important;
  height: 30px !important;
  padding: 4px 9px !important;
  margin: 8px 0 0 !important;
  font-size: 12px !important;
  line-height: 1 !important;
  border-radius: 8px !important;
  box-sizing: border-box !important;
}

/* FINAL FIX: illustration must never intercept the Read button tap */
.card-illustration,
.card-illustration img {
  pointer-events: none !important;
}


/* ===== Class 1-12 Grid Layout ===== */
#classList,
.classList,
#classes,
.classes {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 10px !important;
  width: 100%;
  box-sizing: border-box;
}

#classList button,
.classList button,
#classes button,
.classes button {
  width: 100% !important;
  box-sizing: border-box;
}


